<%= form_with(model: source_lookup) do |form| %>
  <% if source_lookup.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(source_lookup.errors.count, "error") %> prohibited this source_lookup from being saved:</h2>

      <ul>
        <% source_lookup.errors.each do |error| %>
          <li><%= error.full_message %></li>
